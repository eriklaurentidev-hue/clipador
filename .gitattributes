# Arquivos .bat precisam de quebra de linha do Windows (CRLF): com LF o cmd
# erra os "goto" e o instalador falha de jeitos estranhos.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: o git nunca mexe nas quebras de linha deles
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.ico binary
*.bmp binary
*.woff2 binary
*.zip binary

# A trava de segredos e script de shell: precisa de LF
.githooks/* text eol=lf
