    { "src": "/ui/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icone-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Projetos", "url": "/#projetos", "icons": [{ "src": "/ui/icone-192.png", "sizes": "192x192" }] }
  ]
